# Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dbname?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5000

# 🛡️ কোন ওয়েবসাইট থেকে API কল করা যাবে (কমা দিয়ে একাধিক দেওয়া যায়)
# না দিলে ডিফল্ট: https://desh-transport.vercel.app (localhost সবসময় চলবে)
ALLOWED_ORIGIN=https://desh-transport.vercel.app

# 🛡️ নতুন এডমিন বানাতে হলে শুধু তখনই সেট করুন, কাজ শেষে মুছে দিন
# রিকোয়েস্টের হেডারে x-setup-key: <এই মান> দিতে হবে
# ADMIN_SETUP_KEY=long-random-secret
